
@model List<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Current Events";
}

<div class="text-center mb-5">

    <h1>Current Events</h1>

    @if (((EventEase.Models.BookingFilter)ViewBag.Filter).VenueId != null)
    {
        <p class="text-muted">
            Current events for the selected venue.
        </p>
    }
    else
    {
        <p class="text-muted">
            View all upcoming venue bookings.
        </p>
    }

</div>


<div class="mb-4">

    <a asp-controller="Venues"
       asp-action="Index"
       class="btn btn-secondary">
        ← Back to Venues
    </a>

</div>


<!-- Search and filters -->
<partial name="_BookingFilters" model="(EventEase.Models.BookingFilter)ViewBag.Filter" />

<p class="text-muted">
    @Model.Count booking(s) found
</p>


@if (!Model.Any())
{
    <div class="alert alert-info text-center">

        <h5>No bookings found.</h5>

        <p class="mb-0">
            Try a different search or clear the filters.
        </p>

    </div>
}
else
{
    <div class="row">

        @foreach (var booking in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body d-flex flex-column">

                        <!-- Event heading -->
                        <div class="d-flex justify-content-between align-items-start mb-2">

                            <h4 class="card-title mb-0">
                                @booking.EventName
                            </h4>

                            <span class="badge bg-success">
                                Booked
                            </span>

                        </div>

                        @if (booking.EventType != null)
                        {
                            <span class="badge bg-secondary mb-2">
                                @booking.EventType.Name
                            </span>
                        }

                        <hr />

                        <p class="mb-2">
                            <strong>Booking ID:</strong>
                            #@booking.Id
                        </p>

                        <p class="mb-2">
                            <strong>Venue:</strong>
                            @booking.Venue?.Name

                            @if (booking.Venue != null)
                            {
                                if (booking.Venue.IsAvailable)
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Unavailable</span>
                                }
                            }
                        </p>

                        <p class="mb-2 text-muted">
                            📍 @booking.Venue?.Location
                        </p>

                        <p class="mb-2">
                            <strong>Customer:</strong>
                            @booking.CustomerName
                        </p>

                        <p class="mb-2">
                            <strong>Date:</strong>
                            @booking.EventDate.ToString("dd MMMM yyyy")
                        </p>

                        <p class="mb-2">
                            <strong>Time:</strong>
                            @booking.StartTime.ToString(@"hh\:mm")
                            -
                            @booking.EndTime.ToString(@"hh\:mm")
                        </p>

                        <p class="mb-3">
                            <strong>Guests:</strong>
                            @booking.NumberOfGuests
                        </p>


                        <!-- Buttons -->
                        <div class="mt-auto pt-2">

                            <a asp-controller="Bookings"
                               asp-action="Confirmation"
                               asp-route-id="@booking.Id"
                               class="btn btn-primary btn-sm">
                                View Booking
                            </a>

                            <a asp-controller="Events"
                               asp-action="Edit"
                               asp-route-id="@booking.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-controller="Bookings"
                               asp-action="Delete"
                               asp-route-id="@booking.Id"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}
