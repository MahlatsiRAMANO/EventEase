
@model List<EventEase.Models.Venue>

@{
    ViewData["Title"] = "Available Venues";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <strong>Success!</strong>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <strong>Error!</strong>
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="text-center mb-5">
    <h1>Available Venues</h1>

    <p class="text-muted">
        Find the perfect venue for your next event.
    </p>
</div>

<!-- Current Events Button -->
<div class="text-center mb-4">

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-primary">
        Current Events
    </a>

</div>

<!-- Availability filter -->
<form asp-controller="Venues"
      asp-action="Index"
      method="get"
      class="d-flex justify-content-center align-items-center gap-3 mb-4">

    <div class="form-check mb-0">

        <input type="checkbox"
               id="availableOnly"
               name="availableOnly"
               value="true"
               class="form-check-input"
               checked="@ViewBag.AvailableOnly" />

        <label class="form-check-label" for="availableOnly">
            Show available venues only
        </label>

    </div>

    <button type="submit" class="btn btn-outline-primary btn-sm">
        Apply
    </button>

</form>

<!-- Venues -->
<div class="row">

    @if (!Model.Any())
    {
        <div class="col-12">

            <div class="alert alert-info text-center">
                No venues are currently available.
            </div>

        </div>
    }
    else
    {
        @foreach (var venue in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    <img src="~/Images/@venue.ImageFileName"
                         class="card-img-top"
                         alt="@venue.Name"
                         style="height: 220px; object-fit: cover;" />

                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start">

                            <h4 class="card-title">
                                @venue.Name
                            </h4>

                            @if (venue.IsAvailable)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Unavailable</span>
                            }

                        </div>

                        <p class="text-muted mb-2">
                            📍 @venue.Location
                        </p>

                        <p class="card-text">
                            @venue.Description
                        </p>

                        <p>
                            <strong>Capacity:</strong>
                            @venue.Capacity guests
                        </p>

                        <div class="mt-auto">

                            @if (venue.IsAvailable)
                            {
                                <a asp-controller="Bookings"
                                   asp-action="Create"
                                   asp-route-venueId="@venue.Id"
                                   class="btn btn-success">
                                    Book Now
                                </a>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-secondary"
                                        disabled>
                                    Unavailable
                                </button>
                            }

                            <a asp-controller="Venues"
                               asp-action="Edit"
                               asp-route-id="@venue.Id"
                               class="btn btn-warning">
                                Edit
                            </a>

                            <a asp-controller="Venues"
                               asp-action="Delete"
                               asp-route-id="@venue.Id"
                               class="btn btn-danger">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }
    }

</div>

