
@model List<EventEase.Models.Venue>

@{
    ViewData["Title"] = "Available Venues";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <strong>Success!</strong>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <strong>Error!</strong>
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="text-center mb-5">
    <h1>Available Venues</h1>

    <p class="text-muted">
        Find the perfect venue for your next event.
    </p>
</div>

<!-- Current Events Button -->
<div class="text-center mb-4">

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-primary">
        Current Events
    </a>

</div>

<!-- Venues -->
<div class="row">

    @if (!Model.Any())
    {
        <div class="col-12">

            <div class="alert alert-info text-center">
                No venues are currently available.
            </div>

        </div>
    }
    else
    {
        @foreach (var venue in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    <img src="~/Images/@venue.ImageFileName"
                         class="card-img-top"
                         alt="@venue.Name"
                         style="height: 220px; object-fit: cover;" />

                    <div class="card-body d-flex flex-column">

                        <h4 class="card-title">
                            @venue.Name
                        </h4>

                        <p class="text-muted mb-2">
                            📍 @venue.Location
                        </p>

                        <p class="card-text">
                            @venue.Description
                        </p>

                        <p>
                            <strong>Capacity:</strong>
                            @venue.Capacity guests
                        </p>

                        <div class="mt-auto">

                            <a asp-controller="Bookings"
                               asp-action="Create"
                               asp-route-venueId="@venue.Id"
                               class="btn btn-success">
                                Book Now
                            </a>

                            <a asp-controller="Venues"
                               asp-action="Delete"
                               asp-route-id="@venue.Id"
                               class="btn btn-danger">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }
    }

</div>

